# Official DeepSeek chat API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# OpenRouter embeddings only: do not use OpenAI / Google / Anthropic models.
OPENROUTER_API_KEY=
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# Verify requested output dimension in the first smoke test.
EMBEDDING_DIMENSION=1024
EMBEDDING_BACKEND=openrouter
API_TIMEOUT=60
MAX_TOKENS=4096
ENABLE_THINKING=false
USE_STREAMING=false

# Load with experiments.bootstrap.load_environment() before importing the pipeline.
